{
  "name": "@adkinn/fifth-edition-srd-mcp",
  "version": "1.2.0",
  "description": "stdio MCP server for SRD 5.2.1 monsters and conditions (2024 rules)",
  "type": "module",
  "bin": {
    "fifth-edition-srd-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "node -e \"require('fs').cpSync('../data', './data', {recursive: true, force: true})\" && npm run build",
    "prepack": "npm run prepare",
    "test": "node --experimental-test-snapshots --test dist/test/*.test.js",
    "test:build": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "srd",
    "ttrpg",
    "fifth-edition",
    "5e",
    "2024"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adkinn/srd-5.2.1.git"
  },
  "homepage": "https://github.com/adkinn/srd-5.2.1#readme",
  "bugs": {
    "url": "https://github.com/adkinn/srd-5.2.1/issues"
  },
  "author": "Adam Kinney (https://adamkinney.com)"
}
